# Copy to .env (next to docker-compose.yml) to override defaults, e.g. if a port collides.
# Nothing here is required - docker compose up --build works with none of this set.

# --- Ports on the HOST machine (left side of "host:container") ---
MONGO_PORT=27018  # 27017 is likely taken by a local MongoDB install
BACKEND_PORT=8080
FRONTEND_PORT=8081

# --- Backend ---
JWT_SECRET=change-this-dev-only-secret-key-must-be-at-least-32-bytes-long
APP_TIME_ZONE=Asia/Kolkata
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:5173
SEED_DEMO_DATA=true
DRIVER_SIMULATOR_ENABLED=true

# --- Frontend (build-time only - changing this needs `docker compose up --build` to take effect) ---
# Must match BACKEND_PORT above, since the browser calls the backend directly, not through the frontend container.
VITE_API_BASE_URL=http://localhost:8080
