# Copy to .env and fill in before running. All external services below are free-tier / open-source.
# Nothing here needs to be set to start the app with defaults (local MongoDB + public OSRM/Nominatim
# demo servers), but override JWT_SECRET before any real deployment.

# --- Database (MongoDB) ---
MONGODB_URI=mongodb://localhost:27017/routeflow

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
JWT_ACCESS_TTL_MIN=60
JWT_REFRESH_TTL_MIN=1440

# --- Routing engine (OSRM) ---
# Public demo server (fair-use, no key required): https://router.project-osrm.org
# For reliable/production use, self-host OSRM via docker-compose with a Geofabrik .osm.pbf extract.
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_PROFILE=driving

# --- Geocoding (Nominatim / OpenStreetMap) ---
# Free, no key required, but respect usage policy (~1 req/sec) and set a real contact User-Agent.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=RouteFlow/0.1 (contact: your-email@example.com)

# --- CORS (frontend origin, comma separated) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# --- Operating timezone: decides what "today" is and how shift times map to instants ---
APP_TIME_ZONE=Asia/Kolkata

# --- Driver simulator (demo mode without real driver phones) ---
DRIVER_SIMULATOR_ENABLED=true
DRIVER_SIMULATOR_TICK_MS=3000
# virtual-time fast-forward so a demo route finishes in minutes
DRIVER_SIMULATOR_SPEED_MULTIPLIER=8
# ticks a simulated driver dwells at a stop before auto-delivering (time for you to click Deliver + capture POD)
DRIVER_SIMULATOR_DWELL_TICKS=10

# --- Seed the demo scenario on an EMPTY database, and enable POST /api/admin/demo/reset. Set false in production. ---
SEED_DEMO_DATA=true

# --- API output dump script (scripts/fetch-api-output.js) ---
API_BASE_URL=http://localhost:8080
API_LOGIN_EMAIL=dispatcher@routeflow.dev
API_LOGIN_PASSWORD=Dispatcher@123
